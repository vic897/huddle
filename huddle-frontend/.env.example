# Huddle Frontend Environment Variables

# ==============================================================================
# Local Development (defaults used when unset):
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Backend WebSocket Endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Google OAuth 2.0 / OpenID Connect Client ID
# Authorized JavaScript origin must include http://localhost:3000 in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=73151215086-a5k8cdrq1qipb0duqbra4jdfurpjaepk.apps.googleusercontent.com

# ==============================================================================
# Production Deployment (e.g., Vercel Project Settings > Environment Variables):
# ==============================================================================
#
# NEXT_PUBLIC_API_URL must point to your deployed backend HTTPS API:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
#
# NEXT_PUBLIC_WS_URL must point to your deployed backend secure WebSocket (WSS) endpoint:
#   NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws
#
# NEXT_PUBLIC_GOOGLE_CLIENT_ID must match the Google OAuth client ID configured
# in Google Cloud Console with your production domain listed under Authorized JavaScript origins:
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com
