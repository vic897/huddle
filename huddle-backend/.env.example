# Huddle Backend Environment Variables

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_USERNAME=postgres
DB_PASSWORD=123456789
# Full JDBC URL override (required on hosted platforms e.g. Neon, Supabase, RDS)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/huddle

# ==============================================================================
# Server & Network Configuration
# ==============================================================================
# Port binding supports dynamic host port injection (e.g. Render, Railway, Heroku)
PORT=8080

# Production Allowed Origins for CORS and WebSocket (comma-separated, no wildcards, no localhost in prod)
# Required in 'prod' profile. Example: https://huddle.app,https://www.huddle.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public Frontend URL (used in email verification and password reset links)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Security & Authentication
# ==============================================================================
# JWT Signing Secret (must be a strong, random 256-bit+ string; startup fails if default or blank in prod)
JWT_SECRET=change-this-to-a-real-secret-before-any-deploy

# Google OAuth 2.0 Client ID (Required in 'prod' profile; startup fails if missing)
# Must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly
GOOGLE_CLIENT_ID=73151215086-a5k8cdrq1qipb0duqbra4jdfurpjaepk.apps.googleusercontent.com

# Allowed College / Institution Email Domains (comma-separated allowlist for automatic verification)
ALLOWED_EMAIL_DOMAINS=cityengineeringcollege.ac.in

# ==============================================================================
# Email & SMTP Delivery
# ==============================================================================
# In development (true), emails and action links are safely logged to console.
# In production (prod profile default: false), emails are dispatched via SMTP and links are NEVER logged.
EMAIL_DEV_MODE=true

# Real SMTP Provider Configuration (Required in production for email delivery)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-service-account@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password
