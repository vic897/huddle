# Huddle Backend Environment Variables

# PostgreSQL Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=123456789
# Optional full JDBC URL override (default: jdbc:postgresql://localhost:5432/huddle)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/huddle

# Server Port
# PORT=8080

# JWT Signing Secret (must be a strong, random 256-bit+ secret in production)
JWT_SECRET=change-this-to-a-real-secret-before-any-deploy

# Allowed College / Institution Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=cityengineeringcollege.ac.in

# Google OAuth 2.0 Client ID (Required in production 'prod' profile; optional in local dev)
# Must match the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly
GOOGLE_CLIENT_ID=73151215086-a5k8cdrq1qipb0duqbra4jdfurpjaepk.apps.googleusercontent.com
